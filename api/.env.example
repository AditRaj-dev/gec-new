# ==============================================================================
# GEC Digital Platform - API Environment Configuration
# Reference: deployment.md Section 5.3 & Integration Specs
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=development
PORT=4000
SERVICE_VERSION=1.0.0-dev
PUBLIC_APP_URL=http://localhost:3000
CMS_APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug

# Core Neon PostgreSQL (Users, Sessions, Publications, Submissions, Audit, Outbox, Copilot)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/gec_core?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@ep-sample.region.neon.tech/gec_core?sslmode=require

# Forms Neon PostgreSQL (Google Forms registry, revisions, plans, manual requirements, response cache, sheet exports)
FORMS_DATABASE_URL=postgresql://user:password@ep-forms-pooler.region.neon.tech/gec_forms?sslmode=require
FORMS_DATABASE_DIRECT_URL=postgresql://user:password@ep-forms.region.neon.tech/gec_forms?sslmode=require

# MongoDB Atlas (Draft documents, immutable published snapshots, compositions)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=gec_cms_development

# JWT & Session Authentication
JWT_ACCESS_SECRET=replace_with_min_256_bits_random_secret_string_for_access
JWT_REFRESH_SECRET=replace_with_min_256_bits_random_secret_string_for_refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_BASE_URL=http://localhost:3001/reset-password

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=sample_cloudflare_account_id
R2_ENDPOINT=https://sample_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=sample_r2_access_key_id
R2_SECRET_ACCESS_KEY=sample_r2_secret_access_key
R2_PUBLIC_BUCKET=gec-public-media-development
R2_PRIVATE_BUCKET=gec-private-submissions-development
R2_PUBLIC_BASE_URL=http://localhost:4000/media-mock
UPLOAD_URL_TTL_SECONDS=900

# Cache Invalidation & Transactional Outbox
REVALIDATION_URL=http://localhost:3000/api/revalidate
REVALIDATION_HMAC_SECRET=replace_with_min_256_bits_random_hmac_secret_string
OUTBOX_POLL_INTERVAL_MS=5000

# Mail & Notifications (SMTP)
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=mailer@gec.org
SMTP_PASSWORD=secret_smtp_password
MAIL_FROM="Galgotias Entrepreneurship Cell <noreply@gec.org>"

# Google Gemini Copilot Orchestration
GEMINI_API_KEY=sample_gemini_developer_api_key
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GEMINI_ALLOWED_MODELS=gemini-2.0-flash,gemini-1.5-pro,gemini-1.5-flash

# Google Workspace Automation Account (Forms, Drive, Sheets)
GOOGLE_WORKSPACE_CLIENT_ID=sample_oauth_client_id.apps.googleusercontent.com
GOOGLE_WORKSPACE_CLIENT_SECRET=sample_oauth_client_secret
GOOGLE_WORKSPACE_REFRESH_TOKEN=sample_oauth_refresh_token
GOOGLE_DRIVE_FOLDER_ID=sample_drive_folder_id
