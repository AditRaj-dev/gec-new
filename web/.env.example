# Public Next.js Website Environment Configuration
# Reference: deployment.md Section 5.1 & architecture.md Section 7.3

# Environment name: development, preview, staging, or production
APP_ENV=development

# Server-side base URL for the NestJS API
API_BASE_URL=http://localhost:4000

# Canonical public-site origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Matching Cloudflare public media origin (custom domain)
NEXT_PUBLIC_MEDIA_BASE_URL=https://media-staging.gec.in

# Server-only shared HMAC secret for authenticating cache invalidation from NestJS Outbox
REVALIDATION_HMAC_SECRET=dev-revalidation-secret-at-least-256-bits-long-example
